set(AMNETHRON_VERSION_FILE "${CMAKE_SOURCE_DIR}/VERSION.txt")

set(AMNETHRON_VERSION "$ENV{INPUT_VERSION}")
if (AMNETHRON_VERSION STREQUAL "" AND EXISTS "${AMNETHRON_VERSION_FILE}")
    file(READ "${AMNETHRON_VERSION_FILE}" AMNETHRON_VERSION)
    string(STRIP "${AMNETHRON_VERSION}" AMNETHRON_VERSION)
endif ()
if (AMNETHRON_VERSION STREQUAL "")
    set(AMNETHRON_VERSION "0.1.0")
endif ()

string(REGEX REPLACE "^v" "" AMNETHRON_VERSION "${AMNETHRON_VERSION}")
string(REGEX MATCH "^([0-9]+)\\.([0-9]+)\\.([0-9]+)(\\.([0-9]+))?([-.].*)?$" AMNETHRON_VERSION_MATCH "${AMNETHRON_VERSION}")
if (NOT AMNETHRON_VERSION_MATCH)
    message(FATAL_ERROR "Invalid AMNETHRON_VERSION: ${AMNETHRON_VERSION}. Expected MAJOR.MINOR.PATCH[.BUILD].")
endif ()

set(AMNETHRON_VERSION_MAJOR "${CMAKE_MATCH_1}")
set(AMNETHRON_VERSION_MINOR "${CMAKE_MATCH_2}")
set(AMNETHRON_VERSION_PATCH "${CMAKE_MATCH_3}")
if (CMAKE_MATCH_5 STREQUAL "")
    set(AMNETHRON_VERSION_BUILD "0")
else ()
    set(AMNETHRON_VERSION_BUILD "${CMAKE_MATCH_5}")
endif ()

set(NKR_VERSION "${AMNETHRON_VERSION}")
set(AMNETHRON_VERSION_RESOURCE "${AMNETHRON_VERSION_MAJOR}.${AMNETHRON_VERSION_MINOR}.${AMNETHRON_VERSION_PATCH}.${AMNETHRON_VERSION_BUILD}")

message("[AMNETHRON_VERSION] ${AMNETHRON_VERSION}")
